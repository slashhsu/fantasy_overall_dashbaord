# Private dashboard access. Use a long, unique password in production.
APP_PASSWORD=replace-with-a-long-password

# Required in production. Use an independent secret with at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Yahoo OAuth 2.0 server-side credentials.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
YAHOO_REDIRECT_URI=https://your-project.vercel.app

# Recommended documented NBA schedule provider. Create a free key at balldontlie.io.
# The app uses a zero-config ESPN fallback when this is blank or unavailable.
BALLDONTLIE_API_KEY=

# Cache and free-agent pagination controls.
CACHE_TTL_SECONDS=300
FREE_AGENT_LIMIT=300

# Local preview only. Never enable this for the live Yahoo dashboard.
YAHOO_DEMO_MODE=false

# Per-instance protections: 60s forced-refresh cooldown, max 2 Yahoo requests,
# 10s queue timeout. Fixed defaults; no Redis or external service required.
